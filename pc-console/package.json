{
  "name": "m350-pc-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,BRIDGE -c cyan,green \"vinext dev\" \"node bridge/server.mjs\"",
    "dev:web": "vinext dev",
    "bridge": "node bridge/server.mjs",
    "mock": "node bridge/mock-telemetry.mjs",
    "build": "vinext build",
    "start": "concurrently -k -n WEB,BRIDGE -c cyan,green \"vinext start\" \"node bridge/server.mjs\"",
    "start:web": "vinext start",
    "test": "node --test bridge/protocol.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern bridge/runtime"
  },
  "dependencies": {
    "concurrently": "^10.0.5",
    "hls.js": "^1.7.1",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
