# TTL side of the FC30 USB-to-TTL adapter is wired to AGX J30 UART pins.
# Use /dev/ttyUSB0 instead when the serial adapter is plugged into AGX USB.
DJI_UART0_DEVICE=/dev/ttyTHS0

# PPS input configured for this Jetson carrier board.
PPS_GPIOCHIP=/dev/gpiochip0
PPS_GPIO_LINE=123

# Fixed destination for outbound UDP status packets.
UDP_TARGET_IP=192.168.0.1
