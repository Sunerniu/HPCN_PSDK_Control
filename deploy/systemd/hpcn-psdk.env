# AGX GPIO27 / PPS input
PPS_GPIOCHIP=/dev/gpiochip0
PPS_GPIO_LINE=85

# DJI E-Port UART connected directly to Jetson pins
DJI_UART0_DEVICE=/dev/ttyTHS0

# UART1 is only for the Extension Port USB virtual serial device (ttyACM).
# Keep it disabled when E-Port TX/RX is wired directly to Jetson UART pins.
DJI_UART1_ENABLE=0
DJI_UART1_DEVICE=/dev/ttyACM0

# Aircraft time received on this M300 Extension Port is UTC+8 wall time.
AIRCRAFT_TIME_UTC_OFFSET_MINUTES=480

# Fixed computer IP that receives AGX UDP status packets on port 14550
UDP_TARGET_IP=10.29.213.243

# Keep precise positioning queries disabled unless explicitly required
ENABLE_PRECISE_POSITIONING=0

# PSDK Liveview (aircraft/gimbal camera -> AGX). This requires a build made with
# -DPSDK_ENABLE_USB_BULK=ON and a configured Jetson FunctionFS USB gadget.
LIVEVIEW_ENABLE=0
LIVEVIEW_CAMERA=fpv
LIVEVIEW_SOURCE=default
LIVEVIEW_OUTPUT_FILE=
LIVEVIEW_QUEUE_MB=8

# Low-bandwidth Jetson hardware transcoding and RTSP output
RTSP_ENABLE=1
RTSP_PORT=8554
RTSP_PATH=/m350/fpv
# Leave empty for automatic interface detection, or set the reachable AGX IP.
RTSP_ADVERTISED_HOST=
VIDEO_WIDTH=640
VIDEO_HEIGHT=360
VIDEO_FPS=10
VIDEO_BITRATE_KBPS=800
VIDEO_IDR_INTERVAL_SECONDS=2

# Make systemd wait until startup_bulk has created all FunctionFS endpoints.
PSDK_USB_BULK_REQUIRED=0
PSDK_USB_BULK_WAIT_SECONDS=30

# These values must exactly match the descriptors used by DJI startup_bulk.
# The values below match this project's NVIDIA Jetson composite gadget HAL.
DJI_USB_BULK_VID=0x0955
DJI_USB_BULK_PID=0x7020
DJI_USB_BULK1_INTERFACE=7
DJI_USB_BULK1_EP_IN=0x88
DJI_USB_BULK1_EP_OUT=0x05
DJI_USB_BULK1_EP_OUT_PATH=/dev/usb-ffs/bulk1/ep1
DJI_USB_BULK1_EP_IN_PATH=/dev/usb-ffs/bulk1/ep2
DJI_USB_BULK2_INTERFACE=8
DJI_USB_BULK2_EP_IN=0x89
DJI_USB_BULK2_EP_OUT=0x06
DJI_USB_BULK2_EP_OUT_PATH=/dev/usb-ffs/bulk2/ep1
DJI_USB_BULK2_EP_IN_PATH=/dev/usb-ffs/bulk2/ep2
